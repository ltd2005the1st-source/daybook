# --- Supabase (online mode, real-time sync between phone and laptop) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the reminder cron to read your schedule. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret that turns your 4-digit PIN into a long password only the server knows.
# Any long random string (32+ characters). Never change it after you sign up, or your PIN stops working.
PIN_PEPPER=make-up-another-long-random-string

# --- Ask Claude (Haiku assistant). Server only, from console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Set to 1 to allow the assistant in local mode (only on your own machine).
# ALLOW_LOCAL_CHAT=1

# --- Phone reminders (web push). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the scheduler sends to /api/cron/reminders
CRON_SECRET=make-up-a-long-random-string

# Leave the Supabase lines empty to run in local mode (data stays in this browser).
