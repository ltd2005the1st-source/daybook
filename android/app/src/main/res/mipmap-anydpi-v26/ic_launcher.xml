<?xml version="1.0" encoding="utf-8"?>
<!-- Daybook's icon is full-bleed, so it fills the whole adaptive shape.
     The monochrome layer is used by Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_maskable" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@drawable/ic_notification_icon" />
</adaptive-icon>
